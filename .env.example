# Copy to .env and fill in. .env is gitignored — it never leaves this machine.
# These values are pushed into the local TrueForge server by `npm run configure`.
# Judges / strangers never need this file; the README route uses the UI instead.

# Where your local TrueForge is running
TRUEFORGE_URL=http://localhost:3000

# --- Model provider (pick ONE provider you have a key for) ---
# Used by scripts/configure.mjs to find the matching catalog preset.
# Common values: anthropic | openai | google | zai  (see `npm run configure` output)
MODEL_PROVIDER=anthropic

# The provider API key — ONLY consumed locally by configure.mjs, then stored
# inside TrueForge's own settings store. Never printed, never committed.
MODEL_API_KEY=

# The model the Cleanroom agent uses, as provider/model
MODEL_FQN=anthropic/claude-sonnet-4-5

# --- Sandbox provider (free tier is enough: https://daytona.io) ---
DAYTONA_API_KEY=

# --- Skill source ref (branch or tag of THIS repo to load the skill from) ---
# Use `main` after PR #1 merges; during development a branch name works too.
SKILL_REF=main
