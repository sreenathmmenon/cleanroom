# Copy to .env for scripts/seed-agent.mjs. Never commit a real .env.
# Real API keys live ONLY in the TrueForge UI (Settings), never in this repo.

TRUEFORGE_URL=http://localhost:3000

# Optional override for the agent's model, as configured in TrueForge Settings → Models.
# Format: provider/model, e.g. anthropic/claude-sonnet-4-5, openai/gpt-5.2
MODEL_FQN=
